# Secrets for `supabase start` (copy to supabase/.env, never commit it).
SUPABASE_AUTH_EXTERNAL_X_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_X_SECRET=
# Legacy X OAuth 1.0a, only if [auth.external.twitter] is enabled in config.toml.
SUPABASE_AUTH_EXTERNAL_TWITTER_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_TWITTER_SECRET=
