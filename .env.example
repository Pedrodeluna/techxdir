# Supabase CLI secrets for local X sign-in. Copy to .env at the repository root.
# Use the X app's OAuth 1.0a API Key and API Secret Key, not its OAuth 2.0 Client ID/Secret.
# Register http://127.0.0.1:55321/auth/v1/callback in the X app.
SUPABASE_AUTH_EXTERNAL_TWITTER_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_TWITTER_SECRET=

# Reserved for the OAuth 2.0 provider (disabled in supabase/config.toml).
SUPABASE_AUTH_EXTERNAL_X_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_X_SECRET=
